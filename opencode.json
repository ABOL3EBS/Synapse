{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["opencode.md", "doc/STATUS.md", "doc/components/*/context.md"],
  "default_agent": "plan",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "cargo build*": "allow",
      "cargo test*": "allow"
    }
  }
}
